rules_version = '2';

// Cloud Storage rules for submitted files (src/backend/files.js).
//
// A file lives at projects/{projectId}/documents/{fileId}, one path per
// document version. Files are immutable (CLAUDE.md invariants): a group member
// may create a PDF at a new path, and nobody may overwrite or delete one.
// Annotations never touch the file — they are Firestore records drawn over it.
//
// Reads mirror `document.read` in firestore.rules (canViewProject — keep the
// two in step), so the System Administrator never opens a file (T20). The
// panel's latest-version-only rule (T15) is enforced on the `documents`
// records the client lists; a panelist who already holds an old file's path
// could still fetch it — close that with a Cloud Function-issued URL if the
// team needs it.

service firebase.storage {
  match /b/{bucket}/o {

    function institutional() {
      return request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email.matches('.*@hau[.]edu[.]ph') ||
        request.auth.token.email.matches('.*@student[.]hau[.]edu[.]ph')
      );
    }

    function holds(role) { return role in request.auth.token.globalRoles; }
    // An override that revokes project.view or document.read everywhere (claims.js).
    function hidden() { return request.auth.token.get('hidden', false) == true; }
    function projectRoles(projectId) { return request.auth.token.projects.get(projectId, []); }
    function projectOf(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
    }
    function stageIn(project, stages) { return project.currentStage in stages; }
    function capstone1(project) {
      return stageIn(project, ['GROUP_FORMATION', 'ADVISER_ASSIGNMENT', 'ADVISER_APPROVAL',
        'TOPIC_PROPOSAL', 'PROPOSAL_DEVELOPMENT', 'PANEL_ASSIGNMENT',
        'PROPOSAL_DEFENSE_SCHEDULING', 'PROPOSAL_DEFENSE', 'PROPOSAL_REVISION']);
    }

    // Same conditions as canViewProject in firestore.rules.
    function canReadFiles(projectId) {
      let roles = projectRoles(projectId);
      let project = projectOf(projectId);
      return institutional() && !hidden() && (
        'Member' in roles
        || ('Adviser' in roles
            && !stageIn(project, ['GROUP_FORMATION', 'ADVISER_ASSIGNMENT', 'ADVISER_APPROVAL']))
        || ('Instructor 1' in roles && capstone1(project))
        || ('Instructor 2' in roles && !capstone1(project))
        || (('Panel Chair' in roles || 'Panel Member' in roles)
            && !stageIn(project, ['GROUP_FORMATION', 'ADVISER_ASSIGNMENT', 'ADVISER_APPROVAL',
                                  'TOPIC_PROPOSAL', 'PROPOSAL_DEVELOPMENT']))
        || (holds('Program Chair/Coordinator')
            && project.program in request.auth.token.programScope
            && stageIn(project, ['ADVISER_ASSIGNMENT', 'PANEL_ASSIGNMENT', 'PROPOSAL_DEFENSE_SCHEDULING',
                                 'PROPOSAL_REVISION', 'FINAL_DEFENSE_ENDORSEMENT', 'CLEARANCE']))
        || ((holds('Dean') || holds('Associate Dean'))
            && stageIn(project, ['ADVISER_APPROVAL', 'FINAL_APPROVAL', 'ARCHIVED']))
        || (holds('University Research Office') && stageIn(project, ['URO_VERIFICATION']))
      );
    }

    // The PDF document types each stage accepts: allowedDocTypes() in caac.js,
    // less the video (a link, never a file). At URO_VERIFICATION the group
    // re-uploads only the certificates the URO returned; which ones is checked
    // by the service, so either is allowed here. storageRules.test.js fails if
    // this map and caac.js drift apart.
    function pdfTypesAt(stage) {
      return {
        'TOPIC_PROPOSAL': ['Topic Proposal', 'Concept Paper'],
        'PROPOSAL_DEVELOPMENT': ['Proposal Manuscript'],
        'PROPOSAL_DEFENSE': ['Proposal Manuscript'],
        'PROPOSAL_REVISION': ['Revised Manuscript'],
        'IMPLEMENTATION': ['Final Manuscript', 'Deployment Information'],
        'FINAL_DEFENSE': ['Final Manuscript'],
        'FINAL_REVISION': ['Revised Manuscript'],
        'CLEARANCE': ['Final Manuscript', "Editor's Certificate", 'Plagiarism Clearance Certificate'],
        'URO_VERIFICATION': ["Editor's Certificate", 'Plagiarism Clearance Certificate'],
      }.get(stage, []);
    }

    // What submitDocument writes beside the bytes (files.js put → metadata).
    // The fingerprint cannot be checked here; it is kept so the record and the
    // stored file can be matched later.
    function describesUpload(projectId) {
      let meta = request.resource.metadata;
      return meta.keys().hasOnly(['projectId', 'docType', 'uploadedBy', 'sha256'])
        && meta.projectId == projectId
        && meta.uploadedBy is string && meta.uploadedBy.size() > 0
        && meta.sha256.matches('[0-9a-f]{64}')
        && meta.docType in pdfTypesAt(projectOf(projectId).currentStage);
    }

    match /projects/{projectId}/documents/{fileId} {
      allow read: if canReadFiles(projectId);
      // Write-once: only a group member, only a new path (named as filePath()
      // in files.js names it), only a non-empty PDF up to MAX_PDF_MB = 25, only
      // a type the project's stage accepts.
      allow create: if institutional()
        && 'Member' in projectRoles(projectId)
        && resource == null
        && fileId.matches('[a-z0-9]{12,}-[A-Za-z0-9_.-]{0,76}[.][pP][dD][fF]')
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && describesUpload(projectId);
      allow update, delete: if false;
    }

    // A form signed outside the system (FM-AAC-SOC-2003/2004/2005, Approval
    // Sheet), uploaded back as the signatory's copy: PDF, or a JPG/PNG scan or
    // photo (uploadFormFile in submissionFile.js). Anyone who can read the
    // project's files may add one at a new path; whether it is their turn to
    // sign is checked by the service before the copy is recorded
    // (functions/app/files.js verifyForm). Write-once like documents.
    function describesForm(projectId) {
      let meta = request.resource.metadata;
      return meta.keys().hasOnly(['projectId', 'formType', 'uploadedBy', 'sha256'])
        && meta.projectId == projectId
        && meta.formType in ['FM-AAC-SOC-2003', 'FM-AAC-SOC-2004', 'FM-AAC-SOC-2005', 'Approval Sheet']
        && meta.uploadedBy is string && meta.uploadedBy.size() > 0
        && meta.sha256.matches('[0-9a-f]{64}');
    }

    match /projects/{projectId}/forms/{fileId} {
      allow read: if canReadFiles(projectId);
      allow create: if canReadFiles(projectId)
        && resource == null
        && fileId.matches('[a-z0-9]{12,}-[A-Za-z0-9_.-]{0,76}[.]([pP][dD][fF]|[jJ][pP][eE]?[gG]|[pP][nN][gG])')
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && describesForm(projectId);
      allow update, delete: if false;
    }

    match /{everything=**} {
      allow read, write: if false;
    }
  }
}
