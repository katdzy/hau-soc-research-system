# Firebase Emulator Suite: Node 22 + Java 21 (Firestore/Storage emulators run on the JVM).
FROM node:22-alpine

RUN apk add --no-cache openjdk21-jre-headless bash

# Pinned so every machine runs the same emulators; bump deliberately
# (docker compose build emulators) after checking the release notes.
ARG FIREBASE_TOOLS_VERSION=15.32.1
RUN npm install -g firebase-tools@${FIREBASE_TOOLS_VERSION} --no-audit --no-fund

# Bake the emulator binaries into the image so a fresh container does not
# download them on every start.
RUN firebase setup:emulators:firestore \
 && firebase setup:emulators:storage \
 && firebase setup:emulators:ui

# The project is bind-mounted here by docker-compose.yml.
WORKDIR /app

EXPOSE 4000 4400 4500 5001 8080 9099 9199

# FIREBASE_CONFIG picks the rules: emulator/firebase.json (open, the default)
# or firebase.json (the real rules). Data is imported from and saved back to
# .emulator-data so it survives restarts.
CMD ["sh", "-c", "D=/app/.emulator-data; [ -f $D/firebase-export-metadata.json ] && IMPORT=\"--import $D\"; exec firebase emulators:start --project demo-local --config \"${FIREBASE_CONFIG:-emulator/firebase.json}\" $IMPORT --export-on-exit $D"]
