# Backend adapter: "local" (default, zero setup) or "firebase"
VITE_BACKEND=local

# Only needed when VITE_BACKEND=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Real push for device notifications (Firebase build only). Firebase console →
# Project settings → Cloud Messaging → Web Push certificates → key pair.
# Empty = notifications show only while the app is open.
VITE_FIREBASE_VAPID_KEY=

# Point the SDK at the local Firebase Emulator Suite instead of production
VITE_USE_EMULATORS=false

# Firebase build: where writes go. "functions" = through the `act` Cloud
# Function (needs it deployed — Blaze plan — or the Functions emulator);
# "direct" = the browser writes to Firestore itself (only where the rules allow
# it). Empty = functions on the emulators, direct on a live project.
VITE_WRITE_PATH=

# Gemini AI API Key
VITE_GEMINI_API_KEY=
