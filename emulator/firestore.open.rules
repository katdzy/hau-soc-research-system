rules_version = '2';

// Emulator-only rules: let the React app write straight to Firestore.
// The real rules (../firestore.rules) deny every client write because writes
// are meant to go through Cloud Functions, which this repo does not have yet.
// Never deploy this file. To test the real rules, start the emulators with
// FIREBASE_CONFIG=firebase.json (see docker-compose.yml).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
