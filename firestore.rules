rules_version = '2';

// Security rules for the Firebase build.
//
// CAAC enforcement, split the way the Review of Related Literature describes
// it (p. 6) and as resolved for Open Questions #1:
//   • WRITES never come from the client. Every write goes through a Cloud
//     Function, which checks the caller's Global Role and Project-Based Role
//     against their CAAC permissions before committing (Admin SDK, bypasses
//     these rules).
//   • READS are decided here, so the React app can use real-time listeners.
//
// The rules read the caller's context from custom claims that the Cloud
// Functions keep in sync whenever an account, membership, assignment or
// override changes (functions/claims.js, syncClaims.js):
//   token.userId         the caller's `users` id — records name people by it,
//                        not by the Auth uid (the app links the two by email)
//   token.globalRoles    ['Dean'], ['Student'], [] …
//   token.programScope   programs a Program Chair/Coordinator covers
//   token.projects       { <projectId>: ['Adviser', 'Panel Member', 'Member'] }
//   token.hidden         true while an override revokes project.view or
//                        document.read for every project
//
// The stage conditions below mirror src/domain/caac.js (project.view). Keep
// the two in step.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function institutional() {
      return signedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email.matches('.*@hau[.]edu[.]ph') ||
        request.auth.token.email.matches('.*@student[.]hau[.]edu[.]ph')
      );
    }

    function holds(role) { return role in request.auth.token.globalRoles; }

    function me() { return request.auth.token.get('userId', ''); }

    function hidden() { return request.auth.token.get('hidden', false) == true; }

    function projectRoles(projectId) {
      return request.auth.token.projects.get(projectId, []);
    }

    function stageIn(project, stages) { return project.currentStage in stages; }

    function capstone1(project) {
      return stageIn(project, ['GROUP_FORMATION', 'ADVISER_ASSIGNMENT', 'ADVISER_APPROVAL',
        'TOPIC_PROPOSAL', 'PROPOSAL_DEVELOPMENT', 'PANEL_ASSIGNMENT',
        'PROPOSAL_DEFENSE_SCHEDULING', 'PROPOSAL_DEFENSE', 'PROPOSAL_REVISION']);
    }

    // State-based progressive visibility: the same person can read a project
    // at one stage and not at another. Mirrors `project.view` + `document.read`
    // in caac.js (flags as set in src/domain/flags.js on 2026-09-29).
    function canViewProject(projectId, project) {
      let roles = projectRoles(projectId);
      return institutional() && !hidden() && (
        'Member' in roles
        // An Adviser gets access once the Dean and AD approve the appointment (S2.2).
        || ('Adviser' in roles
            && !stageIn(project, ['GROUP_FORMATION', 'ADVISER_ASSIGNMENT', 'ADVISER_APPROVAL']))
        || ('Instructor 1' in roles && capstone1(project))           // I1_ACCESS_AFTER_ROUTING = 'none'
        || ('Instructor 2' in roles && !capstone1(project))
        || (('Panel Chair' in roles || 'Panel Member' in roles)
            && !stageIn(project, ['GROUP_FORMATION', 'ADVISER_ASSIGNMENT', 'ADVISER_APPROVAL',
                                  'TOPIC_PROPOSAL', 'PROPOSAL_DEVELOPMENT']))
        // NEW-11 (PC_PROGRAM_VISIBILITY = summary-outside-pc-steps): only while a PC step is active.
        || (holds('Program Chair/Coordinator')
            && project.program in request.auth.token.programScope
            && stageIn(project, ['ADVISER_ASSIGNMENT', 'PANEL_ASSIGNMENT', 'PROPOSAL_DEFENSE_SCHEDULING',
                                 'PROPOSAL_REVISION', 'FINAL_DEFENSE_ENDORSEMENT', 'CLEARANCE']))
        || ((holds('Dean') || holds('Associate Dean'))
            && stageIn(project, ['ADVISER_APPROVAL', 'FINAL_APPROVAL', 'ARCHIVED']))
        || (holds('University Research Office') && stageIn(project, ['URO_VERIFICATION']))
      );
    }

    // §2.2: the System Administrator opens the project record for configuration
    // and audit, never its documents (T20).
    function canOpenRecord(projectId, project) {
      return canViewProject(projectId, project) || (institutional() && !hidden() && holds('System Administrator'));
    }

    function viaProject(projectId) {
      return canViewProject(projectId, get(/databases/$(database)/documents/projects/$(projectId)).data);
    }

    function projectOf(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    match /users/{userId} {
      allow read: if institutional();
      allow write: if false;
    }

    match /sections/{sectionId} {
      allow read: if institutional();
      allow write: if false;
    }

    // Group drafts (STUDENT_GROUP_DRAFTS): names and statuses only, read by any
    // institutional account so students can see their invitations and
    // Instructor 1 their section's drafts. Written through `act`.
    match /groupDrafts/{draftId} {
      allow read: if institutional();
      allow write: if false;
    }

    // S-17 (caac.js archive.browse): every active, verified account browses the
    // archive's metadata — the archived project record, its members and its
    // assignments (for the adviser's name). Never its documents or history.
    function archived(project) { return project.currentStage == 'ARCHIVED'; }

    match /projects/{projectId} {
      allow read: if canOpenRecord(projectId, resource.data)
        || (institutional() && !hidden() && archived(resource.data));
      allow write: if false;
    }

    // Project record: who is in it, who is assigned, what happened.
    match /{col}/{docId} {
      allow read: if col in ['projectMembers', 'projectAssignments', 'workflowHistory']
        && canOpenRecord(resource.data.projectId, projectOf(resource.data.projectId));
      allow write: if false;
    }
    match /{col}/{docId} {
      allow read: if col in ['projectMembers', 'projectAssignments']
        && institutional() && !hidden() && archived(projectOf(resource.data.projectId));
      allow write: if false;
    }

    // Project content: never the System Administrator.
    match /{col}/{docId} {
      allow read: if col in ['documents', 'reviews', 'weeklyLogs', 'defenses', 'forms']
        && viaProject(resource.data.projectId);
      allow write: if false;
    }

    // OQ#2 (AI_SUMMARY_AUDIENCE = Adviser + Panel). Feature not built yet (R12).
    match /aiSummaries/{summaryId} {
      allow read: if viaProject(resource.data.projectId) && (
        'Adviser' in projectRoles(resource.data.projectId)
        || 'Panel Chair' in projectRoles(resource.data.projectId)
        || 'Panel Member' in projectRoles(resource.data.projectId)
      );
      allow write: if false;
    }

    // Private panel notes: the author always; once the Panel Chair records the
    // verdict (`releasedAt`), the group's students (OQ#3, PANEL_NOTES_RELEASE).
    // Never shared between panelists. Shared notes follow project visibility.
    match /annotations/{annotationId} {
      allow read: if institutional() && viaProject(resource.data.projectId) && (
        resource.data.authorId == me()
        || resource.data.visibility == 'shared'
        || (resource.data.releasedAt != null && 'Member' in projectRoles(resource.data.projectId))
      );
      allow write: if false;
    }

    // Permission overrides (flag PERMISSION_OVERRIDES = 'deny-only'). The claims
    // sync must drop a project from token.projects while `project.view` or
    // `document.read` is revoked for it, so the rules above also honour the
    // override. Readable by the System Administrator and the affected account.
    match /permissionOverrides/{overrideId} {
      allow read: if institutional()
        && (holds('System Administrator') || resource.data.userId == me());
      allow write: if false;
    }

    // Global settings (revision countdown). Every signed-in account reads them.
    match /settings/{settingId} {
      allow read: if institutional();
      allow write: if false;
    }

    // One row per email (R6c). Its recipients read it: the open app mirrors it
    // as a device notification (DEVICE_NOTIFICATIONS, revision 2026-10-07).
    match /outbox/{mailId} {
      allow read: if institutional() && me() in resource.data.userIds;
      allow write: if false;
    }

    // FCM device tokens. Written by registerPushToken / unregisterPushToken and
    // read by deliverOutbox (Cloud Functions, Admin SDK); never by a client.
    match /pushTokens/{tokenId} {
      allow read, write: if false;
    }

    // Touched by syncClaims (Cloud Functions) after it changes an account's
    // claims; the signed-in app listens to its own and refreshes its ID token.
    // Keyed by Auth uid.
    match /claimsSync/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Write-once activity log, readable by the System Administrator.
    match /auditLogs/{logId} {
      allow read: if institutional() && holds('System Administrator');
      allow write: if false;
    }
  }
}
